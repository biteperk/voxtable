# Dependencies
node_modules/

# Environment and secrets
.env
.env.*
!.env.example
!.env.local.example

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
coverage/

# Package manager caches
.npm/
.pnpm-store/
.yarn/
!.yarn/releases/
!.yarn/plugins/
!.yarn/sdks/
!.yarn/versions/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local databases and generated data
*.sqlite
*.sqlite3
*.db
tmp/
temp/

# Hosting and tooling
.vercel/
.railway/
.firebase/
.turbo/
.cache/

# TypeScript
*.tsbuildinfo

# OS and editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
docker-compose.override.yml
firebase-admin.json

# Claude Code local session config (per-developer launch.json etc.)
.claude/

# Local ops references — account identifiers / PII (vendor logins, SIDs).
# Never committed; secrets belong in the prod env / password manager, not git.
*.local.md

# Top-level scratchpad — source PNGs and brand reference materials that
# feed scripts/ but are never deployed. Real app assets live under
# apps/frontend/public/, which is NOT covered by this rule.
/public/

# ASIC / company registration — holds identity documents (passport, birth
# certificate, Director ID, residential address) and ASIC keys. Never commit.
asic/

# Credentials, recovery codes and key material — never commit.
# Values belong in the shared password vault; repo files may hold pointers only.
*recovery_code*
*recovery-code*
*_2FA_*
*_2fa_*
*.secret
*.secret.*

# Prospect / customer business documents (menus, quotes) — never commit.
# These are other people's business data; keep them outside the repo.
/restaurants/

# Customer collateral (menus, talk tracks, account plans) — belongs in the
# private customers repo / Drive, never in the code repo. Per-venue folders:
Cuban-Corner/

# Vendor correspondence saved to the repo root (Twilio compliance notices,
# bundle approvals, Stripe quotes). They carry account identifiers, ticket
# numbers and contact details — the decisions belong in the runbooks, the
# documents belong in Drive.
/*.pdf
