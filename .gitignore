# Dependencies
node_modules/

# Environment and secrets
.env
.env.*
!.env.example
!.env.local.example

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
coverage/

# Package manager caches
.npm/
.pnpm-store/
.yarn/
!.yarn/releases/
!.yarn/plugins/
!.yarn/sdks/
!.yarn/versions/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local databases and generated data
*.sqlite
*.sqlite3
*.db
tmp/
temp/

# Hosting and tooling
.vercel/
.railway/
.firebase/
.turbo/
.cache/

# TypeScript
*.tsbuildinfo

# OS and editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
docker-compose.override.yml
firebase-admin.json

# Claude Code local session config (per-developer launch.json etc.)
.claude/

# Local ops references — account identifiers / PII (vendor logins, SIDs).
# Never committed; secrets belong in the prod env / password manager, not git.
*.local.md

# Top-level scratchpad — source PNGs and brand reference materials that
# feed scripts/ but are never deployed. Real app assets live under
# apps/frontend/public/, which is NOT covered by this rule.
/public/
