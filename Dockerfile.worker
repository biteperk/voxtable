# ---- Stage 1: Builder ----
FROM node:24-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/frontend/package.json ./apps/frontend/package.json
COPY apps/kds/package.json ./apps/kds/package.json
RUN npm ci

COPY . .

ENV NODE_OPTIONS=--max-old-space-size=2048
RUN npm run build:backend

# ---- Stage 2: Worker Runner ----
FROM node:24-alpine AS runner

WORKDIR /app

# See Dockerfile.api — the release version is baked in at build time so the
# worker's Sentry releases and health surface report the real version rather
# than APP_VERSION's 0.1.0 schema default.
ARG APP_VERSION=0.0.0-dev
ENV APP_VERSION=${APP_VERSION}

# See Dockerfile.api — same openssl CVE, same reason.
RUN apk upgrade --no-cache libcrypto3 libssl3

COPY package.json package-lock.json ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/frontend/package.json ./apps/frontend/package.json
COPY apps/kds/package.json ./apps/kds/package.json
RUN npm ci --workspace=@voxtable/backend --omit=dev --omit=optional && \
    npm cache clean --force && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/apps/backend/db ./apps/backend/db

RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

USER appuser

# Smaller pool allocation than the api: api (40+10) + worker (30+5) = 85 must
# stay under Postgres' 97 usable connections — see src/config/env.ts. The
# application_name override makes pg_stat_activity distinguish the two
# processes during an incident.
ENV PG_POOL_MAX_WRITE=30 \
    PG_POOL_MAX_READ=5 \
    PG_APPLICATION_NAME=voxtable-worker

# The worker had NO healthcheck, so a wedged one was invisible: a tick hung
# inside an open transaction stops the Cal.com mirror, notifications,
# provisioning AND the health alerter itself, while the api container stays
# green and /health keeps returning 200.
#
# /workerz — not /livez. /livez only proves the process exists, which is
# exactly what a wedged worker also proves. /workerz returns 503 once a
# started worker has missed too many ticks.
#
# The port mirrors worker.ts: WORKER_HEALTH_PORT, else the injected PORT.
# Shell form so the variables actually expand.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider "http://localhost:${WORKER_HEALTH_PORT:-${PORT:-3050}}/workerz" || exit 1

CMD ["node", "apps/backend/dist/worker.js"]
