# ---- Stage 1: Builder ----
FROM node:24-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/frontend/package.json ./apps/frontend/package.json
COPY apps/kds/package.json ./apps/kds/package.json
RUN npm ci

COPY . .

ENV NODE_OPTIONS=--max-old-space-size=2048
RUN npm run build:backend

# ---- Stage 2: Worker Runner ----
FROM node:24-alpine AS runner

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/frontend/package.json ./apps/frontend/package.json
COPY apps/kds/package.json ./apps/kds/package.json
RUN npm ci --workspace=@vocotable/backend --omit=dev --omit=optional && \
    npm cache clean --force && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/apps/backend/db ./apps/backend/db

RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

USER appuser

# Smaller pool allocation than the api: api (40+10) + worker (30+5) = 85 must
# stay under Postgres' 97 usable connections — see src/config/env.ts. The
# application_name override makes pg_stat_activity distinguish the two
# processes during an incident.
ENV PG_POOL_MAX_WRITE=30 \
    PG_POOL_MAX_READ=5 \
    PG_APPLICATION_NAME=vocotable-worker

CMD ["node", "apps/backend/dist/worker.js"]
