{
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "app",
      "public": "apps/frontend/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            { "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }
          ]
        },
        {
          "source": "**/*.@(svg|png|ico|webp|webmanifest|avif|jpg|jpeg)",
          "headers": [
            { "key": "Cache-Control", "value": "public,max-age=2592000,immutable" }
          ]
        },
        {
          "source": "**/*.@(html)",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "frame-src 'self' https://cal.com https://app.cal.com https://*.firebaseapp.com https://accounts.google.com https://*.googleapis.com; child-src 'self' https://cal.com https://app.cal.com https://*.firebaseapp.com https://accounts.google.com;"
            }
          ]
        }
      ]
    },
    {
      "target": "kds",
      "public": "apps/kds/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/index.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache" }
          ]
        },
        {
          "source": "/sw.js",
          "headers": [
            { "key": "Cache-Control", "value": "max-age=0, must-revalidate" }
          ]
        },
        {
          "source": "**/assets/**",
          "headers": [
            { "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }
          ]
        },
        {
          "source": "**/*.@(png|webp|webmanifest|svg|ico|mp3|wav)",
          "headers": [
            { "key": "Cache-Control", "value": "public,max-age=2592000,immutable" }
          ]
        }
      ]
    }
  ]
}
