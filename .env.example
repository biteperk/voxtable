# VocoTable backend environment — copy to .env and fill real values.
#   cp .env.example .env
# Every var is parsed/validated by apps/backend/src/config/env.ts (Zod).
# Booleans are the strings "true"/"false". Most integrations ship OFF behind a
# kill-switch flag and are a no-op until both the flag is "true" AND the keys
# are set. In production (APP_ENV=production) a superRefine enforces the
# requirements noted inline; in development everything optional can be blank.
# NEVER commit a filled-in .env (it's gitignored) — secrets stay out of git.
#
# THE THREE SECURITY GATES — DASHBOARD_VERIFY_AUTH, RETELL_VERIFY_SIGNATURE and
# TWILIO_VALIDATE_SIGNATURE — default to TRUE and may only be false while
# PUBLIC_API_BASE_URL is localhost. The backend refuses to start otherwise. They
# are set to false here because this file describes a laptop.

# ── Core ─────────────────────────────────────────────────────────────────────
APP_ENV=development                 # REQUIRED, no default: development | test | production | migration
APP_VERSION=0.1.0
PORT=3050
WORKER_HEALTH_PORT=3055             # worker's own health surface (/livez /readyz /workerz); MUST differ from PORT when dev:backend + dev:worker share a host. Unset in Cloud Run (separate container reuses PORT).
PUBLIC_API_BASE_URL=http://localhost:3050   # prod: https://api.biteperk.com.au (must NOT be localhost; see deploy/runbooks/domain-migration.md)
CORS_ALLOWED_ORIGINS=                       # comma-separated browser origins allowed to call the API; required when PUBLIC_API_BASE_URL is not localhost
DATABASE_URL=postgres://vocotable:vocotable@localhost:5432/vocotable   # REQUIRED
DATABASE_SSL=false
# Per-process pool ceilings — api + worker TOTAL must stay under Postgres'
# usable connections (default 97). Defaults: api 40+10; the worker image
# overrides to 30+5. PG_APPLICATION_NAME shows in pg_stat_activity.
PG_POOL_MAX_WRITE=40
PG_POOL_MAX_READ=10
PG_APPLICATION_NAME=vocotable-api
DEFAULT_RESTAURANT_ID=11111111-1111-4111-8111-111111111111   # the seeded tenant; keep as-is

# ── Dashboard auth (Firebase) ────────────────────────────────────────────────
DASHBOARD_VERIFY_AUTH=false          # defaults TRUE. false is only allowed on localhost
FIREBASE_PROJECT_ID=vocotable        # required when DASHBOARD_VERIFY_AUTH=true
GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-admin.json   # path to the service-account JSON
FIREBASE_AUTH_TIMEOUT_MS=5000        # deadline on verifyIdToken; timeouts map to 503, never 401
# Comma-separated allowlists. ALLOWED empty = any verified Google account (dev only;
# prod requires non-empty → invite-only: only these emails reach /api/* dashboard routes,
# anyone else gets 403 EMAIL_NOT_ALLOWLISTED). MANAGER ⊂ ALLOWED gates menu/payment/cancel.
# ADMIN gates /api/admin/*.   e.g. DASHBOARD_ALLOWED_EMAILS=staff1@example.com,staff2@example.com
DASHBOARD_ALLOWED_EMAILS=
DASHBOARD_MANAGER_EMAILS=
# KITCHEN ⊂ ALLOWED: the KDS kiosk account(s) → 'kitchen' role (reads role-gated /api/orders/*).
DASHBOARD_KITCHEN_EMAILS=
DASHBOARD_ADMIN_EMAILS=
# MULTITENANCY_LEGACY_FALLBACK was removed on 2 Aug 2026 (migration 027). Access is
# restaurant_members and nothing else — to give someone access, give them a row.

# ── Retell (voice agent) ─────────────────────────────────────────────────────
RETELL_API_KEY=                      # REST API key (1st-key in the Retell dashboard)
RETELL_WEBHOOK_SECRET=               # the "Secret Key (Webhook)" — signs x-retell-signature (distinct from API key)
RETELL_AGENT_ID=                     # optional, dev/single-tenant fallback only — the real value is per-restaurant data (restaurants.retell_agent_id, set by provisioning/bind)
# The LLM behind the agent (llm_...). Lets the retell-variables worker keep
# today/tomorrow current on the LLM's default_dynamic_variables. Leave blank and
# those fall back to whatever was last set by hand — which is how "tomorrow"
# silently became "today" after midnight.
RETELL_LLM_ID=
RETELL_PHONE_NUMBER=
RETELL_VERIFY_SIGNATURE=false        # defaults TRUE. false is only allowed on localhost. Verifies inbound webhook signatures with RETELL_WEBHOOK_SECRET
# The core product's kill switch. Defaults TRUE — leave it unset in normal
# operation. Set false during an incident to make Bella refuse every tool call
# with a spoken apology while webhooks and call logging stay live. Unlike the
# security gates, false is legal in production — that is the whole point.
VOICE_BOOKING_ENABLED=true

# ── Twilio (telephony) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=                 # optional, dev/single-tenant fallback only — the real value is per-restaurant data (restaurants.twilio_phone_number); routing reads only the database
TWILIO_TERMINATION_URI=
TWILIO_RETELL_SIP_URI=sip:sip.retellai.com
TWILIO_VALIDATE_SIGNATURE=false      # defaults TRUE. false is only allowed on localhost

# ── Cal.com mirror (optional integration) ────────────────────────────────────
CALCOM_SYNC_ENABLED=false            # flag. When true (prod), the keys below are required
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=              # dev fallback only — per-venue in restaurants.calcom_event_type_id (035); MUST be unset in production
CALCOM_BASE_URL=https://api.cal.com/v2
CALCOM_WEBHOOK_SECRET=
CALCOM_REQUEST_TIMEOUT_MS=5000
CALCOM_OUTBOX_MAX_ATTEMPTS=8
CALCOM_DAILY_QUOTA_THRESHOLD=        # optional; Slack ping when today's Cal.com request count crosses this

# ── Ops / observability ──────────────────────────────────────────────────────
OPS_SLACK_WEBHOOK_URL=               # Slack incoming-webhook for health + daily onboarding-funnel alerts
OPS_HEARTBEAT_URL=                   # Dead-man's switch: healthchecks.io-style ping URL, GET on every alerter tick; the external service alerts when pings STOP
SENTRY_DSN=                          # optional error tracking; no-op when unset
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Stripe billing (Phase 3) ─────────────────────────────────────────────────
STRIPE_BILLING_ENABLED=false         # flag. When true (prod): SECRET_KEY + PRICE_ID + WEBHOOK_SECRET required
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=                     # the recurring Price ($80/mo) for self-serve checkout
STRIPE_WEBHOOK_SECRET=               # from `stripe listen` (dev) / the prod webhook endpoint
STRIPE_TRIAL_DAYS=7                   # free trial length; the UI reads this back, so both always agree
STRIPE_PORTAL_RETURN_URL=https://app.biteperk.com.au/billing
STRIPE_CHECKOUT_SUCCESS_URL=https://app.biteperk.com.au/onboarding
STRIPE_CHECKOUT_CANCEL_URL=https://app.biteperk.com.au/onboarding
STRIPE_REQUEST_TIMEOUT_MS=10000

# ── Menu OCR (Phase 2) — vision-LLM menu parsing ─────────────────────────────
MENU_OCR_ENABLED=false               # flag. When true: API_KEY required (+ BASE_URL when PROVIDER=openai)
MENU_OCR_PROVIDER=anthropic          # anthropic | openai (openai = any OpenAI-compatible host for open-weight VLMs)
MENU_OCR_BASE_URL=                   # required when PROVIDER=openai, e.g. https://openrouter.ai/api/v1
MENU_OCR_API_KEY=
MENU_OCR_MODEL=claude-3-5-sonnet-latest   # e.g. qwen/qwen-2.5-vl-72b-instruct (OpenRouter) or gemini-2.0-flash
MENU_OCR_MAX_FILE_MB=10
MENU_OCR_MAX_JOBS_PER_DAY=25
MENU_OCR_REQUEST_TIMEOUT_MS=60000
# Model for the recovery pass — the single-page re-read of a page the first pass
# got nothing from. Blank = reuse MENU_OCR_MODEL, but SET IT to something
# stronger in production: asking the same model the same question twice is a
# correlated second opinion, and independence is the whole point of the re-read.
# Recovery runs on at most a handful of pages of a menu that already looks wrong,
# so it is the cheapest place to spend on accuracy. Prod uses gemini-2.5-pro.
MENU_OCR_VERIFY_MODEL=
MENU_OCR_MAX_VERIFY_PAGES=8           # ceiling on re-reads per job
MENU_OCR_MAX_CALLS_PER_JOB=24         # first pass + retries + recovery, shared
MENU_OCR_JOB_BUDGET_MS=420000         # wall clock per parse; under the UI's 10-min poll ceiling
MENU_OCR_ALLOWED_HOSTS=firebasestorage.googleapis.com  # comma-separated, exact hostname match.
                                     # source_url is client-supplied and fetched server-side, so
                                     # this pin is what stops it reaching internal addresses.

# ── Notifications (Phase 5) — email via SendGrid or ZeptoMail, SMS via Twilio ─
NOTIFICATIONS_ENABLED=false          # flag
EMAIL_PROVIDER=sendgrid              # sendgrid | zeptomail
SENDGRID_API_KEY=
ZEPTOMAIL_TOKEN=                     # Zoho ZeptoMail send-mail token (AU DC)
ZEPTOMAIL_BASE_URL=https://api.zeptomail.com.au/v1.1
NOTIFICATIONS_FROM_EMAIL=hello@biteperk.com.au
NOTIFICATIONS_SMS_FROM=
NOTIFICATIONS_REQUEST_TIMEOUT_MS=15000  # per-send cap; the outbox drains sequentially, so
                                        # one hung send would otherwise stall signup codes

# ── Self-serve signup ─────────────────────────────────────────────────────────
SELF_SERVE_SIGNUP_ENABLED=false      # flag. Legal document metadata comes from the frontend GCS manifest
SERVICES_VOXCONCIERGE_ENABLED=false  # flag. The wizard only offers VoxConcierge once this is on
# The backend verifies every acceptance against this manifest before writing
# the agreement_acceptances ledger (409 on mismatch, 503 if unreachable).
# Same object the wizard reads. Required in production when self-serve is on;
# leave empty locally to skip verification (logged as a warning).
LEGAL_DOCUMENTS_MANIFEST_URL=
# Allows acceptances against SAMPLE-*/DRAFT-* document sets. Staging only —
# production keeps this off so placeholder documents can never be "accepted".
TERMS_ALLOW_UNPUBLISHED_DOCS=false

# ── Signup verification codes — 6-digit code emailed via the outbox ──────────
# Kill-switch: OFF ships the routes returning 404 and the frontend falls back
# to the Firebase link flow. Requires NOTIFICATIONS_ENABLED=true in production.
EMAIL_VERIFICATION_CODE_ENABLED=false

# ── Frontend build-time vars (Vite, VITE_*) — baked into the bundle ──────────
# Passed at `npm run build:frontend`, NOT read by the backend. Public by design
# (a browser bundle is shipped to clients); the Maps key is safe because it's
# restricted to our referrers + Places/Maps APIs in the GCP console.
#   VITE_API_BASE_URL=https://api.biteperk.com.au
#   VITE_GOOGLE_MAPS_KEY=AIza...   # Maps JS browser key (Places address autocomplete)
#   VITE_LEGAL_DOCUMENTS_MANIFEST_URL=... # optional override; otherwise derived from VITE_FIREBASE_PROJECT_ID

# ── Automated provisioning (Phase 4b) ────────────────────────────────────────
PROVISIONING_AUTO_ENABLED=false      # flag. When true: RETELL_TEMPLATE_AGENT_ID required
RETELL_TEMPLATE_AGENT_ID=            # template agent cloned per restaurant
PROVISIONING_TWILIO_AREA_CODE=       # e.g. "2" for Sydney

# ── Voice-order payments — Stripe Checkout links texted to callers ───────────
# Kill-switch: OFF ships everything dormant. The flag gates link CREATION only;
# webhook reconciliation keeps settling in-flight links after a flag-off.
# When true (prod): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# NOTIFICATIONS_SMS_FROM, PUBLIC_ORDER_RETURN_BASE_URL required, plus
# NOTIFICATIONS_ENABLED=true and STRIPE_CONNECT_ENABLED=true.
ORDER_PAYMENTS_ENABLED=false
STRIPE_CONNECT_ENABLED=false         # Connect destination charges to venue accounts
ORDER_PAYMENT_EXPIRY_MINUTES=45      # 35–1440; Stripe's floor is 30 + clock-skew margin
ORDER_PAYMENT_FEE_BPS=0              # BitePerk application fee, basis points
ORDER_PAYMENT_FEE_FLAT_CENTS=0      # + flat cents; clamped below the transaction total
PUBLIC_ORDER_RETURN_BASE_URL=        # frontend origin serving /order/paid (e.g. https://app.biteperk.com.au)
