# VocoTable backend environment — copy to .env and fill real values.
#   cp .env.example .env
# Every var is parsed/validated by apps/backend/src/config/env.ts (Zod).
# Booleans are the strings "true"/"false". Most integrations ship OFF behind a
# kill-switch flag and are a no-op until both the flag is "true" AND the keys
# are set. In production (APP_ENV=production) a superRefine enforces the
# requirements noted inline; in development everything optional can be blank.
# NEVER commit a filled-in .env (it's gitignored) — secrets stay out of git.

# ── Core ─────────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | test | production
APP_VERSION=0.1.0
PORT=3050
PUBLIC_API_BASE_URL=http://localhost:3050   # prod: https://vocotable.algorythmos.com.au (must NOT be localhost)
DATABASE_URL=postgres://vocotable:vocotable@localhost:5432/vocotable   # REQUIRED
DATABASE_SSL=false
DEFAULT_RESTAURANT_ID=11111111-1111-4111-8111-111111111111   # the seeded tenant; keep as-is

# ── Dashboard auth (Firebase) ────────────────────────────────────────────────
DASHBOARD_VERIFY_AUTH=false          # prod: true (forced). false = no auth (dev only)
FIREBASE_PROJECT_ID=vocotable        # required when DASHBOARD_VERIFY_AUTH=true
GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-admin.json   # path to the service-account JSON
# Comma-separated allowlists. ALLOWED empty = any verified Google account (dev only;
# prod requires non-empty → invite-only: only these emails reach /api/* dashboard routes,
# anyone else gets 403 EMAIL_NOT_ALLOWLISTED). MANAGER ⊂ ALLOWED gates menu/payment/cancel.
# ADMIN gates /api/admin/*.   e.g. DASHBOARD_ALLOWED_EMAILS=staff1@example.com,staff2@example.com
DASHBOARD_ALLOWED_EMAILS=
DASHBOARD_MANAGER_EMAILS=
# KITCHEN ⊂ ALLOWED: the KDS kiosk account(s) → 'kitchen' role (reads role-gated /api/orders/*).
DASHBOARD_KITCHEN_EMAILS=
DASHBOARD_ADMIN_EMAILS=
# Rollout bridge: allowlisted users with no membership → DEFAULT_RESTAURANT_ID. Remove after backfill.
MULTITENANCY_LEGACY_FALLBACK=false

# ── Retell (voice agent) ─────────────────────────────────────────────────────
RETELL_API_KEY=                      # REST API key (1st-key in the Retell dashboard)
RETELL_WEBHOOK_SECRET=               # the "Secret Key (Webhook)" — signs x-retell-signature (distinct from API key)
RETELL_AGENT_ID=
RETELL_PHONE_NUMBER=
RETELL_VERIFY_SIGNATURE=false        # prod: true. Verifies inbound webhook signatures with RETELL_WEBHOOK_SECRET

# ── Twilio (telephony) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TERMINATION_URI=
TWILIO_RETELL_SIP_URI=sip:sip.retellai.com
TWILIO_VALIDATE_SIGNATURE=false      # prod: true

# ── Cal.com mirror (optional integration) ────────────────────────────────────
CALCOM_SYNC_ENABLED=false            # flag. When true (prod), the keys below are required
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_BASE_URL=https://api.cal.com/v2
CALCOM_WEBHOOK_SECRET=
CALCOM_REQUEST_TIMEOUT_MS=5000
CALCOM_OUTBOX_MAX_ATTEMPTS=8
CALCOM_DAILY_QUOTA_THRESHOLD=        # optional; Slack ping when today's Cal.com request count crosses this

# ── Ops / observability ──────────────────────────────────────────────────────
OPS_SLACK_WEBHOOK_URL=               # Slack incoming-webhook for health + daily onboarding-funnel alerts
SENTRY_DSN=                          # optional error tracking; no-op when unset
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Stripe billing (Phase 3) ─────────────────────────────────────────────────
STRIPE_BILLING_ENABLED=false         # flag. When true (prod): SECRET_KEY + PRICE_ID + WEBHOOK_SECRET required
STRIPE_SECRET_KEY=
STRIPE_CUSTOMER_ID=                  # legacy single-tenant fallback only
STRIPE_PRICE_ID=                     # the recurring Price ($80/mo) for self-serve checkout
STRIPE_WEBHOOK_SECRET=               # from `stripe listen` (dev) / the prod webhook endpoint
STRIPE_TRIAL_DAYS=14
STRIPE_PORTAL_RETURN_URL=https://vocotable.web.app/billing
STRIPE_CHECKOUT_SUCCESS_URL=https://vocotable.web.app/onboarding
STRIPE_CHECKOUT_CANCEL_URL=https://vocotable.web.app/onboarding
STRIPE_REQUEST_TIMEOUT_MS=10000

# ── Menu OCR (Phase 2) — vision-LLM menu parsing ─────────────────────────────
MENU_OCR_ENABLED=false               # flag. When true: API_KEY required (+ BASE_URL when PROVIDER=openai)
MENU_OCR_PROVIDER=anthropic          # anthropic | openai (openai = any OpenAI-compatible host for open-weight VLMs)
MENU_OCR_BASE_URL=                   # required when PROVIDER=openai, e.g. https://openrouter.ai/api/v1
MENU_OCR_API_KEY=
MENU_OCR_MODEL=claude-3-5-sonnet-latest   # e.g. qwen/qwen-2.5-vl-72b-instruct (OpenRouter) or gemini-2.0-flash
MENU_OCR_MAX_FILE_MB=10
MENU_OCR_MAX_JOBS_PER_DAY=25
MENU_OCR_REQUEST_TIMEOUT_MS=60000
MENU_OCR_ALLOWED_HOSTS=firebasestorage.googleapis.com  # comma-separated, exact hostname match.
                                     # source_url is client-supplied and fetched server-side, so
                                     # this pin is what stops it reaching internal addresses.

# ── Notifications (Phase 5) — email via SendGrid or ZeptoMail, SMS via Twilio ─
NOTIFICATIONS_ENABLED=false          # flag
EMAIL_PROVIDER=sendgrid              # sendgrid | zeptomail
SENDGRID_API_KEY=
ZEPTOMAIL_TOKEN=                     # Zoho ZeptoMail send-mail token (AU DC)
ZEPTOMAIL_BASE_URL=https://api.zeptomail.com.au/v1.1
NOTIFICATIONS_FROM_EMAIL=hello@biteperk.com.au
NOTIFICATIONS_SMS_FROM=
NOTIFICATIONS_REQUEST_TIMEOUT_MS=15000  # per-send cap; the outbox drains sequentially, so
                                        # one hung send would otherwise stall signup codes

# ── Signup verification codes — 6-digit code emailed via the outbox ──────────
# Kill-switch: OFF ships the routes returning 404 and the frontend falls back
# to the Firebase link flow. Requires NOTIFICATIONS_ENABLED=true in production.
EMAIL_VERIFICATION_CODE_ENABLED=false

# ── Frontend build-time vars (Vite, VITE_*) — baked into the bundle ──────────
# Passed at `npm run build:frontend`, NOT read by the backend. Public by design
# (a browser bundle is shipped to clients); the Maps key is safe because it's
# restricted to our referrers + Places/Maps APIs in the GCP console.
#   VITE_API_BASE_URL=https://vocotable.algorythmos.com.au
#   VITE_GOOGLE_MAPS_KEY=AIza...   # Maps JS browser key (Places address autocomplete)

# ── Automated provisioning (Phase 4b) ────────────────────────────────────────
PROVISIONING_AUTO_ENABLED=false      # flag. When true: RETELL_TEMPLATE_AGENT_ID required
RETELL_TEMPLATE_AGENT_ID=            # template agent cloned per restaurant
PROVISIONING_TWILIO_AREA_CODE=       # e.g. "2" for Sydney
