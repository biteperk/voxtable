# ---- Stage 1: Builder ----
FROM node:24-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/frontend/package.json ./apps/frontend/package.json
COPY apps/kds/package.json ./apps/kds/package.json
RUN npm ci

COPY . .

ENV NODE_OPTIONS=--max-old-space-size=2048
RUN npm run build:backend

# ---- Stage 2: API Runner ----
FROM node:24-alpine AS runner

WORKDIR /app

# Alpine ships the openssl fix ahead of the node:24-alpine rebuild, so upgrade
# explicitly — otherwise every image build fails the Trivy HIGH gate on a CVE we
# cannot fix by waiting. Pinning the base image instead would freeze us on the
# vulnerable one.
RUN apk upgrade --no-cache libcrypto3 libssl3 && \
    apk add --no-cache wget

COPY package.json package-lock.json ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/frontend/package.json ./apps/frontend/package.json
COPY apps/kds/package.json ./apps/kds/package.json
RUN npm ci --workspace=@voxtable/backend --omit=dev --omit=optional && \
    npm cache clean --force && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/apps/backend/db ./apps/backend/db

RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

USER appuser

EXPOSE 3050

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3050/health || exit 1

CMD ["node", "apps/backend/dist/server.js"]
