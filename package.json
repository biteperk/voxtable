{
  "name": "vocotable",
  "version": "1.0.0",
  "private": true,
  "description": "Voice AI booking platform for restaurants.",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "apps/kds"
  ],
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "npm run dev --workspace=@vocotable/backend",
    "dev:worker": "npm run dev:worker --workspace=@vocotable/backend",
    "dev:frontend": "npm run dev --workspace=@vocotable/frontend",
    "dev:kds": "npm run dev --workspace=@vocotable/kds",
    "build": "npm run build:backend && npm run build:frontend && npm run build:kds",
    "build:backend": "npm run build --workspace=@vocotable/backend",
    "build:frontend": "npm run build --workspace=@vocotable/frontend",
    "build:kds": "npm run build --workspace=@vocotable/kds",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm run test --workspace=@vocotable/backend",
    "test:frontend": "npm run test --workspace=@vocotable/frontend",
    "lint": "eslint . --max-warnings 27",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run build && npm run test",
    "start:backend": "npm run start --workspace=@vocotable/backend",
    "start:worker": "npm run start:worker --workspace=@vocotable/backend",
    "db:migrate": "npm run db:migrate --workspace=@vocotable/backend",
    "db:seed": "npm run db:seed --workspace=@vocotable/backend",
    "db:migrate:prod": "npm run db:migrate:prod --workspace=@vocotable/backend",
    "preview:frontend": "npm run preview --workspace=@vocotable/frontend",
    "preview:kds": "npm run preview --workspace=@vocotable/kds",
    "smoke:legal": "npm run smoke:legal --workspace=@vocotable/backend",
    "smoke:admin": "npm run smoke:admin --workspace=@vocotable/backend",
    "smoke:isolation": "npm run smoke:isolation --workspace=@vocotable/backend",
    "smoke:menu-ocr": "npm run smoke:menu-ocr --workspace=@vocotable/backend",
    "smoke:double-booking": "npm run smoke:double-booking --workspace=@vocotable/backend",
    "smoke:retry-idempotency": "npm run smoke:retry-idempotency --workspace=@vocotable/backend",
    "smoke:tenant-attribution": "npm run smoke:tenant-attribution --workspace=@vocotable/backend",
    "smoke:calcom-mirror": "npm run smoke:calcom-mirror --workspace=@vocotable/backend",
    "smoke:outbox-deadletter": "npm run smoke:outbox-deadletter --workspace=@vocotable/backend",
    "smoke:solo-diner": "npm run smoke:solo-diner --workspace=@vocotable/backend",
    "smoke:ops-state": "npm run smoke:ops-state --workspace=@vocotable/backend",
    "smoke:business-alerts": "npm run smoke:business-alerts --workspace=@vocotable/backend",
    "smoke:voice-kill-switch": "npm run smoke:voice-kill-switch --workspace=@vocotable/backend",
    "smoke:notification-lease": "npm run smoke:notification-lease --workspace=@vocotable/backend",
    "smoke:booking-sms": "npm run smoke:booking-sms --workspace=@vocotable/backend",
    "smoke:identity-collision": "npm run smoke:identity-collision --workspace=@vocotable/backend",
    "smoke:menu-substitution": "npm run smoke:menu-substitution --workspace=@vocotable/backend",
    "smoke:payment-watch": "npm run smoke:payment-watch --workspace=@vocotable/backend",
    "smoke:sms-sender": "npm run smoke:sms-sender --workspace=@vocotable/backend",
    "smoke:payments": "npm run smoke:payments --workspace=@vocotable/backend",
    "audit:backend": "npm audit --workspace=@vocotable/backend --omit=dev --omit=optional",
    "audit:frontend": "npm audit --workspace=@vocotable/frontend --omit=dev",
    "audit:kds": "npm audit --workspace=@vocotable/kds --omit=dev",
    "audit:production": "npm run audit:backend && npm run audit:frontend && npm run audit:kds",
    "audit:all": "npm audit",
    "firebase": "firebase",
    "dashboard": "node scripts/project-dashboard.mjs",
    "smoke:staging": "npm run smoke:staging --workspace=@vocotable/backend",
    "smoke:agent-routing": "npm run smoke:agent-routing --workspace=@vocotable/backend",
    "smoke:menu-guards": "npm run smoke:menu-guards --workspace=@vocotable/backend",
    "smoke:capacity-ceiling": "npm run smoke:capacity-ceiling --workspace=@vocotable/backend",
    "smoke:inbox-retry": "npm run smoke:inbox-retry --workspace=@vocotable/backend",
    "check:voice-lines": ".claude/skills/retell-agent-quality/scripts/check-all-lines.sh",
    "check:voice-lines:selftest": "node .claude/skills/retell-agent-quality/scripts/selftest-assert-line.mjs",
    "check:seed-identities": "node deploy/scripts/assert-seed-identities.mjs --project bp-voxtable-stg --sibling vocotable deploy/seeds/staging-venue.sql",
    "check:oauth-redirects": "node deploy/scripts/assert-oauth-redirect.mjs 198624206590-sm4ilnql2ve14gk1m0p2cmkpslbb187d.apps.googleusercontent.com bp-voxtable-stg.web.app bp-voxtable-stg.firebaseapp.com"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  }
}
