{
  "name": "vocotable",
  "version": "0.1.1",
  "private": true,
  "description": "Voice AI booking platform for restaurants.",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "apps/kds"
  ],
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "npm run dev --workspace=@vocotable/backend",
    "dev:worker": "npm run dev:worker --workspace=@vocotable/backend",
    "dev:frontend": "npm run dev --workspace=@vocotable/frontend",
    "dev:kds": "npm run dev --workspace=@vocotable/kds",
    "build": "npm run build:backend && npm run build:frontend && npm run build:kds",
    "build:backend": "npm run build --workspace=@vocotable/backend",
    "build:frontend": "npm run build --workspace=@vocotable/frontend",
    "build:kds": "npm run build --workspace=@vocotable/kds",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm run test --workspace=@vocotable/backend",
    "test:frontend": "npm run test --workspace=@vocotable/frontend",
    "check": "npm run build && npm run test",
    "start:backend": "npm run start --workspace=@vocotable/backend",
    "start:worker": "npm run start:worker --workspace=@vocotable/backend",
    "db:migrate": "npm run db:migrate --workspace=@vocotable/backend",
    "db:seed": "npm run db:seed --workspace=@vocotable/backend",
    "db:migrate:prod": "npm run db:migrate:prod --workspace=@vocotable/backend",
    "preview:frontend": "npm run preview --workspace=@vocotable/frontend",
    "preview:kds": "npm run preview --workspace=@vocotable/kds",
    "smoke:menu-ocr": "npm run smoke:menu-ocr --workspace=@vocotable/backend",
    "smoke:double-booking": "npm run smoke:double-booking --workspace=@vocotable/backend",
    "audit:backend": "npm audit --workspace=@vocotable/backend --omit=dev --omit=optional",
    "audit:frontend": "npm audit --workspace=@vocotable/frontend --omit=dev",
    "audit:kds": "npm audit --workspace=@vocotable/kds --omit=dev",
    "audit:production": "npm run audit:backend && npm run audit:frontend && npm run audit:kds",
    "audit:all": "npm audit",
    "firebase": "firebase"
  }
}
