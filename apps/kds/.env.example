# KDS frontend env vars. Mirror these to .env for `vite dev`.

# Backend API.  Local dev defaults to localhost:3050 if unset.
VITE_API_BASE_URL=https://vocotable.algorythmos.com.au

# Firebase Web SDK config (same project as the manager dashboard so the
# allowlist gate works for the kitchen kiosk account).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=vocotable
VITE_FIREBASE_APP_ID=
