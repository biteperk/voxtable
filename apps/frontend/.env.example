# Frontend environment variables (Vite — must be VITE_ prefixed)
# Copy to .env.local for local dev, or set in Firebase Hosting build env for prod.

VITE_API_BASE_URL=http://localhost:3050

# Cal.com embed configuration. Both are read at build time. Leave BLANK to
# hide the "Book online" CTA on the landing page — useful before the Cal.com
# canary is ready in PR 2.
#   CAL_LINK example: "natalias-bistro/reservation" (the path after cal.com/)
#   NAMESPACE: any short identifier; used by the embed script for caching.
VITE_CALCOM_CAL_LINK=
VITE_CALCOM_NAMESPACE=vocotable-bookings

# Google Maps JS API key for the onboarding address autocomplete. Leave BLANK
# to fall back to the plain street-address input (fully supported). The key's
# GCP project must have BOTH "Maps JavaScript API" and "Places API (New)"
# enabled — in prod this is the repo variable VITE_GOOGLE_MAPS_KEY consumed by
# deploy-frontend.yml.
VITE_GOOGLE_MAPS_KEY=

# Error reporting. Leave BLANK locally — everything below is a no-op without it.
# In prod this is the repo SECRET VITE_SENTRY_DSN consumed by
# deploy-frontend.yml. Without it a white-screen crash reaches nobody: the
# ErrorBoundary renders its fallback and reports to /dev/null.
VITE_SENTRY_DSN=
# Tags each report with the build it came from. CI passes the commit SHA.
VITE_APP_VERSION=
